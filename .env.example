# Clave larga y aleatoria usada para cifrar credenciales de equipos.
INVENTORY_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Clave compartida de al menos 12 caracteres para habilitar modificaciones.
# En producción se configura como secreto de Cloudflare, nunca en Git.
INVENTORY_WRITE_PASSWORD=replace-with-a-long-shared-password

# Duración máxima del permiso de edición; recargar la página lo elimina antes.
INVENTORY_WRITE_ACCESS_MINUTES=30

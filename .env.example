# Clave larga y aleatoria usada para cifrar credenciales de equipos.
INVENTORY_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Correo del administrador que puede entrar antes de crear la lista de usuarios.
INVENTORY_ADMIN_EMAIL=admin@example.com

# Actívalo únicamente para una prueba pública temporal mientras se prepara Entra ID.
# Permite operar el inventario sin inicio de sesión, pero no revelar contraseñas.
INVENTORY_PUBLIC_ACCESS=false

# Cloudflare Access: dominio del equipo y audiencia de la aplicación.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-the-application-audience-tag
